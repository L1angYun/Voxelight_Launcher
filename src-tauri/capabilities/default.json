{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Local launcher window, native file picking, confirmations and approved external links",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-message",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://microsoft.com/devicelogin"
        },
        {
          "url": "https://www.microsoft.com/devicelogin"
        },
        {
          "url": "https://microsoft.com/link"
        },
        {
          "url": "https://www.microsoft.com/link"
        },
        {
          "url": "https://login.microsoftonline.com/common/oauth2/deviceauth"
        },
        {
          "url": "https://login.microsoftonline.com/common/oauth2/v2.0/deviceauth"
        },
        {
          "url": "https://login.live.com/oauth20_deviceauth.srf"
        },
        {
          "url": "https://login.live.com/oauth20_remoteconnect.srf"
        },
        {
          "url": "https://www.minecraft.net/en-us/eula"
        },
        {
          "url": "https://aka.ms/MinecraftEULA"
        },
        {
          "url": "https://github.com/L1angYun/Voxelight_Launcher"
        },
        {
          "url": "https://github.com/L1angYun/Voxelight_Launcher/releases/tag/*"
        },
        {
          "url": "https://gitee.com/liangyun_Liu/Voxelight_Launcher/releases/tag/*"
        },
        {
          "url": "https://bmclapi2.bangbang93.com/"
        },
        {
          "url": "https://www.curseforge.com/projects/*"
        },
        {
          "url": "https://www.curseforge.com/minecraft/mc-mods/*"
        },
        {
          "url": "https://www.curseforge.com/minecraft/modpacks/*"
        },
        {
          "url": "https://www.curseforge.com/minecraft/shaders/*"
        },
        {
          "url": "https://www.curseforge.com/minecraft/texture-packs/*"
        },
        {
          "url": "https://modrinth.com/mod/*"
        },
        {
          "url": "https://modrinth.com/resourcepack/*"
        },
        {
          "url": "https://modrinth.com/shader/*"
        },
        {
          "url": "https://modrinth.com/modpack/*"
        },
        {
          "url": "https://modrinth.com/datapack/*"
        }
      ]
    },
    "launcher-shell",
    "launcher-settings",
    "launcher-accounts",
    "launcher-launch",
    "launcher-library",
    "launcher-downloads",
    "launcher-discover",
    "launcher-multiplayer",
    "launcher-updates",
    "launcher-native-paths",
    "launcher-assistant"
  ]
}
