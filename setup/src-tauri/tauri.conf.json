{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voxelight Setup",
  "version": "0.7.0-beta.3",
  "identifier": "dev.voxelight.setup",
  "build": {
    "beforeDevCommand": "npm run setup:dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run setup:build",
    "frontendDist": "../../dist/setup"
  },
  "app": {
    "windows": [
      {
        "label": "setup",
        "create": false,
        "title": "Voxelight Setup",
        "width": 760,
        "height": 500,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "decorations": false,
        "backgroundColor": "#141516"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../src-tauri/icons/icon.ico",
      "../../src-tauri/icons/32x32.png",
      "../../src-tauri/icons/128x128.png"
    ]
  }
}
